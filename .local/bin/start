#!/bin/bash

echo "##############################"
echo "#                            #"
echo "#  HOLA, VYBER SEZENÍ:       #"
echo "#  s) SPUSTIT ARCH           #"
echo "#  r) RESTARTOVAT            #"
echo "#  x) VYPNOUT                #"
echo "#                            #"
echo "##############################"
read -n 1 -s wm_choice
case $wm_choice in
"") exec niri-session -l
;;
s) exec niri-session -l
;;
x) echo "Vypínání..."
   exec systemctl poweroff
   sleep 1
;;
r) echo "Restart..."
   sleep 1
   exec systemctl reboot
;;
*) echo "Vyberte z možností"
;;
esac
