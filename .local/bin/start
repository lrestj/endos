#!/bin/bash

echo "##############################"
echo "#                            #"
echo "#  HOLA, VYBER SEZENÍ:       #"
echo "#                            #"
echo "#  v) VOID Niri              #"
echo "#  r) RESTARTOVAT            #"
echo "#  x) VYPNOUT                #"
echo "#                            #"
echo "##############################"
while true; do
    read -n 1 -s wm_choice
    case $wm_choice in
    v)
    exec dbus-run-session /usr/bin/niri --session
    break;;
    x)
    echo "Vypínání..."
    sleep 1
    exec loginctl poweroff
    break;;
    r)
    echo "Restart..."
    sleep 1
    exec loginctl reboot
    break;;
    *)
    echo "Vyberte jednu z možností"
    ;;
    esac
done
