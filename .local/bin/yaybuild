#!/bin/bash

set -e

echo "Instaluji yay..."
mkdir -p /home/libor/.local/src
cd /home/libor/.local/src
git clone https://aur.archlinux.org/yay.git
cd yay
makepkg -si
echo "########################################"
echo "###  Naistalováno: $(yay --version)  ###"
echo "########################################"
