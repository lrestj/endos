#!/bin/bash

sudo cp -fv /etc/pacman.d/mirrorlist /etc/pacman.d/mirrorlist.old
sudo reflector --verbose --download-timeout 3 --country CZ --country AT --country SK --score 20 --fastest 3 --protocol https --sort rate --save /etc/pacman.d/mirrorlist
echo
echo "####################################################"
echo "###  Run sudo pacman -Syyu after this operation  ###"
echo "####################################################"

